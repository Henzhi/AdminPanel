<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.relic.admin.mapper.SysPermissionMapper">

    <!-- 权限 VO 映射 -->
    <resultMap id="permissionVOMap" type="com.relic.admin.vo.PermissionVO">
        <id property="id" column="id"/>
        <result property="parentId" column="parent_id"/>
        <result property="permCode" column="perm_code"/>
        <result property="permName" column="perm_name"/>
        <result property="permType" column="perm_type"/>
        <result property="path" column="path"/>
        <result property="component" column="component"/>
        <result property="icon" column="icon"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
    </resultMap>

    <!-- 根据角色ID查询其拥有的权限列表 (关联 sys_role_permission) -->
    <select id="selectPermissionsByRoleId" resultMap="permissionVOMap">
        SELECT p.id, p.parent_id, p.perm_code, p.perm_name, p.perm_type,
               p.path, p.component, p.icon, p.sort_order, p.status
        FROM sys_permission p
        INNER JOIN sys_role_permission rp ON p.id = rp.permission_id
        WHERE rp.role_id = #{roleId}
          AND p.deleted = 0
          AND p.status = 1
        ORDER BY p.sort_order ASC
    </select>

    <!-- 查询全部权限 -->
    <select id="selectAllPermissions" resultType="com.relic.admin.entity.SysPermission">
        SELECT id, parent_id, perm_code, perm_name, perm_type, path, component,
               icon, sort_order, status, create_time, update_time
        FROM sys_permission
        WHERE deleted = 0
        ORDER BY sort_order ASC
    </select>

</mapper>
