<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.relic.admin.mapper.SysAdminMapper">

    <!-- 管理员展示 VO 映射 (关联 sys_role 取 role_name) -->
    <resultMap id="adminVOMap" type="com.relic.admin.vo.AdminVO">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="realName" column="real_name"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="avatar" column="avatar"/>
        <result property="roleId" column="role_id"/>
        <result property="roleName" column="role_name"/>
        <result property="status" column="status"/>
        <result property="lastLoginTime" column="last_login_time"/>
        <result property="lastLoginIp" column="last_login_ip"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 公共列片段 -->
    <sql id="adminVOColumns">
        a.id, a.username, a.real_name, a.email, a.phone, a.avatar,
        a.role_id, r.role_name, a.status, a.last_login_time,
        a.last_login_ip, a.create_time
    </sql>

    <!-- 根据ID查询管理员详情 -->
    <select id="selectAdminVOById" resultMap="adminVOMap">
        SELECT <include refid="adminVOColumns"/>
        FROM sys_admin a
        LEFT JOIN sys_role r ON a.role_id = r.id AND r.deleted = 0
        WHERE a.id = #{id} AND a.deleted = 0
    </select>

    <!-- 分页查询管理员列表 -->
    <select id="selectAdminVOPage" resultMap="adminVOMap">
        SELECT <include refid="adminVOColumns"/>
        FROM sys_admin a
        LEFT JOIN sys_role r ON a.role_id = r.id AND r.deleted = 0
        WHERE a.deleted = 0
        <if test="username != null and username != ''">
            AND a.username LIKE CONCAT('%', #{username}, '%')
        </if>
        <if test="roleId != null">
            AND a.role_id = #{roleId}
        </if>
        ORDER BY a.create_time DESC
    </select>

</mapper>
